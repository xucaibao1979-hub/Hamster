# 复制为项目根目录 .env，填写后执行 docker compose up -d --build
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@company.local
ASSET_PORT=3000
# 配置反向代理 HTTPS 时，填写完整访问地址，并将 COOKIE_SECURE 改为 true
APP_ORIGIN=
COOKIE_SECURE=false

# IT小爱可信后端服务凭证，至少32位随机字符串；未配置时外部接口关闭
IT_SERVICE_TOKEN=
# 可选：事件投递地址及对方服务凭证。收件方需按 Idempotency-Key 去重
IT_SYNC_URL=
IT_SYNC_TOKEN=
